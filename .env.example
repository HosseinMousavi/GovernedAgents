# --- Postgres ---
DATABASE_URL=postgresql://ssa:ssa@localhost:5432/ssa   # host-side scripts only; compose picks a free host port (see `docker compose port postgres 5432`)
# --- Tokens (HMAC key for scoped tokens; rotate in prod, inject from Secrets Manager on AWS) ---
TOKEN_SIGNING_KEY=local-compose-signing-key-change-me   # >=16 chars; services refuse to start with the dev default
# --- Governance ---
KILL_SWITCH=false
# --- LLMs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# --- Cost & routing ---
ROUTING_POLICY=routed              # routed | all_default | all_cheap
# CHEAP_MODEL=ollama/ssa-grader    # after `make lora-serve`: the LoRA-tuned local model becomes the cheap tier
BUDGET_SOFT_USD_PER_DAY=5          # per tenant: beyond this every call runs on the cheap tier
BUDGET_HARD_USD_PER_DAY=10         # per tenant: beyond this the agent escalates to a human (0 = no budget)
# --- MCP ---
MCP_SERVER_URL=http://localhost:8765/mcp
# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=store-support-agent
# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook
