# --- Postgres ---
DATABASE_URL=postgresql://ssa:ssa@localhost:5433/ssa   # host-side port of the compose Postgres
POSTGRES_HOST_PORT=5433
# --- Tokens (HMAC key for scoped tokens; rotate in prod, inject from Secrets Manager on AWS) ---
TOKEN_SIGNING_KEY=local-compose-signing-key-change-me   # >=16 chars; services refuse to start with the dev default
# --- Governance ---
KILL_SWITCH=false
# --- LLMs ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# --- MCP ---
MCP_SERVER_URL=http://localhost:8765/mcp
# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=store-support-agent
# --- n8n ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook
