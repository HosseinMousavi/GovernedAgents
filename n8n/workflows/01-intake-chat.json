{
  "name": "01 - Intake chat (Store Support Agent)",
  "nodes": [
    {
      "parameters": {"options": {}},
      "id": "chat-trigger",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [0, 300],
      "webhookId": "store-support-intake"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are the intake assistant for a car-accessories store. Your ONLY job is to collect these fields and output JSON. Ask one question at a time, in this order, skipping any the customer already answered:\n1. order_id - the order number (integer)\n2. category - one of: damaged, missing, wrong_item, defective, other\n3. description - what happened, one or two sentences\n4. desired_outcome - one of: refund, replacement, repair, information\n5. product_hint - product name if mentioned (optional)\nDo NOT ask for name, email, phone, address, or payment details. If the customer offers them, do not repeat them.\nWhen all required fields are known, reply with ONLY this JSON (no prose):\n{\"spec\": {\"order_id\": <int>, \"category\": \"...\", \"description\": \"...\", \"desired_outcome\": \"...\", \"product_hint\": \"...\"}}\nIf a field is still missing, ask the next question in plain language."
        }
      },
      "id": "intake-agent",
      "name": "Intake Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [260, 300]
    },
    {
      "parameters": {"model": "claude-sonnet-4-5", "options": {"temperature": 0}},
      "id": "anthropic-model",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [180, 520],
      "credentials": {"anthropicApi": {"id": "REPLACE_ME", "name": "Anthropic"}}
    },
    {
      "parameters": {"sessionIdType": "fromInput", "contextWindowLength": 12},
      "id": "memory",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [360, 520]
    },
    {
      "parameters": {
        "jsCode": "const text = $json.output ?? '';\nconst m = text.match(/\\{[\\s\\S]*\\}/);\nif (!m) return [{ json: { hasSpec: false, reply: text } }];\ntry {\n  const parsed = JSON.parse(m[0]);\n  const spec = parsed.spec ?? parsed;\n  return [{ json: { hasSpec: true, spec, reply: text } }];\n} catch (e) {\n  return [{ json: { hasSpec: false, reply: text } }];\n}"
      },
      "id": "extract-json",
      "name": "Extract JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "c1", "leftValue": "={{ $json.hasSpec }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
          "combinator": "and"},
        "options": {}
      },
      "id": "if-has-spec",
      "name": "Has spec?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL ?? 'http://agents:8080' }}/intake/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ spec: $json.spec }) }}",
        "options": {}
      },
      "id": "validate-spec",
      "name": "Validate spec (agents service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 200]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "c2", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
          "combinator": "and"},
        "options": {}
      },
      "id": "if-valid",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1260, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL ?? 'http://agents:8080' }}/resolve",
        "sendHeaders": true,
        "headerParameters": {"parameters": [{"name": "Authorization", "value": "=Bearer {{ $env.CUSTOMER_TOKEN }}"}]},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ spec: $('Extract JSON').item.json.spec }) }}",
        "options": {"timeout": 120000}
      },
      "id": "resolve",
      "name": "Resolve (agents service)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1500, 100]
    },
    {
      "parameters": {
        "conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [{"id": "c3", "leftValue": "={{ $json.requires_manager }}", "rightValue": true, "operator": {"type": "boolean", "operation": "true", "singleValue": true}}],
          "combinator": "and"},
        "options": {}
      },
      "id": "if-needs-manager",
      "name": "Needs manager?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1740, 100]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "mode": "list", "value": "REPLACE_WITH_02_WORKFLOW_ID", "cachedResultName": "02 - Manager approval"},
        "workflowInputs": {"mappingMode": "passThrough"},
        "options": {}
      },
      "id": "call-approval",
      "name": "Manager approval",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "workflowId": {"__rl": true, "mode": "list", "value": "REPLACE_WITH_03_WORKFLOW_ID", "cachedResultName": "03 - Ticket notification"},
        "workflowInputs": {"mappingMode": "passThrough"},
        "options": {}
      },
      "id": "call-notify",
      "name": "Ticket notification",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1980, 200]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "a1", "name": "output", "type": "string",
          "value": "={{ $json.answer ? $json.answer + '\\n\\n' : '' }}Proposed: {{ $json.action }}{{ $json.amount_cents ? ' ($' + ($json.amount_cents/100).toFixed(2) + ')' : '' }}. {{ $json.rationale }}{{ $json.ticket_id ? ' Ticket ' + $json.ticket_id + ' created.' : '' }}{{ $json.requires_manager ? ' A manager will review this now.' : '' }} (LLM cost ${{ ($json.cost_usd || 0).toFixed(4) }})"}]},
        "options": {}
      },
      "id": "compose-reply",
      "name": "Compose reply",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2220, 100]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "a2", "name": "output", "type": "string",
          "value": "=I still need: {{ $json.missing.join(', ') }}. {{ $json.errors.map(e => e.field + ': ' + e.problem).join('; ') }}"}]},
        "options": {}
      },
      "id": "reask",
      "name": "Re-ask missing fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1500, 320]
    },
    {
      "parameters": {
        "assignments": {"assignments": [{"id": "a3", "name": "output", "type": "string", "value": "={{ $json.reply }}"}]},
        "options": {}
      },
      "id": "passthrough",
      "name": "Next question",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1020, 440]
    }
  ],
  "connections": {
    "Chat Trigger": {"main": [[{"node": "Intake Agent", "type": "main", "index": 0}]]},
    "Anthropic Chat Model": {"ai_languageModel": [[{"node": "Intake Agent", "type": "ai_languageModel", "index": 0}]]},
    "Window Buffer Memory": {"ai_memory": [[{"node": "Intake Agent", "type": "ai_memory", "index": 0}]]},
    "Intake Agent": {"main": [[{"node": "Extract JSON", "type": "main", "index": 0}]]},
    "Extract JSON": {"main": [[{"node": "Has spec?", "type": "main", "index": 0}]]},
    "Has spec?": {"main": [[{"node": "Validate spec (agents service)", "type": "main", "index": 0}], [{"node": "Next question", "type": "main", "index": 0}]]},
    "Validate spec (agents service)": {"main": [[{"node": "Valid?", "type": "main", "index": 0}]]},
    "Valid?": {"main": [[{"node": "Resolve (agents service)", "type": "main", "index": 0}], [{"node": "Re-ask missing fields", "type": "main", "index": 0}]]},
    "Resolve (agents service)": {"main": [[{"node": "Needs manager?", "type": "main", "index": 0}]]},
    "Needs manager?": {"main": [[{"node": "Manager approval", "type": "main", "index": 0}], [{"node": "Ticket notification", "type": "main", "index": 0}]]},
    "Manager approval": {"main": [[{"node": "Compose reply", "type": "main", "index": 0}]]},
    "Ticket notification": {"main": [[{"node": "Compose reply", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "meta": {"templateCredsSetupCompleted": false}
}
