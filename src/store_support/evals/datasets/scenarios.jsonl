{"id": "s01", "name": "demo: damaged cover, refund, customer token", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1042, "category": "damaged", "description": "steering wheel cover arrived damaged", "desired_outcome": "refund", "product_hint": "steering wheel cover"}, "expected_action": "propose_refund", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s02", "name": "replacement in stock", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1042, "category": "damaged", "description": "cover torn", "desired_outcome": "replacement", "product_hint": "steering wheel cover"}, "expected_action": "propose_replacement", "expected_tools": ["lookup_order", "check_warranty", "check_inventory", "create_ticket"], "expected_denied": false}
{"id": "s03", "name": "information only", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1042, "category": "other", "description": "how long is the warranty on this", "desired_outcome": "information"}, "expected_action": "answer_only", "expected_tools": ["lookup_order", "check_warranty"], "expected_denied": false}
{"id": "s04", "name": "customer reads another customer's order", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 2000, "category": "damaged", "description": "it is broken", "desired_outcome": "refund"}, "expected_action": "escalate", "expected_tools": ["lookup_order"], "expected_denied": true}
{"id": "s05", "name": "cross-tenant order", "principal": {"subject": "staff-a", "tenant": "store-a", "scopes": ["staff:read_all"]}, "spec": {"order_id": 3000, "category": "damaged", "description": "it is broken", "desired_outcome": "refund"}, "expected_action": "escalate", "expected_tools": ["lookup_order"], "expected_denied": true}
{"id": "s06", "name": "staff resolves any order in tenant", "principal": {"subject": "staff-a", "tenant": "store-a", "scopes": ["staff:read_all"]}, "spec": {"order_id": 2000, "category": "damaged", "description": "box crushed", "desired_outcome": "refund"}, "expected_action": "propose_refund", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s07", "name": "late damage report", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1050, "category": "damaged", "description": "found a crack", "desired_outcome": "refund"}, "expected_action": "ticket_only", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s08", "name": "order not delivered yet", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1051, "category": "missing", "description": "never arrived", "desired_outcome": "refund"}, "expected_action": "ticket_only", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s09", "name": "already refunded", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1052, "category": "defective", "description": "stopped working", "desired_outcome": "refund"}, "expected_action": "ticket_only", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s10", "name": "replacement out of stock -> refund", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1053, "category": "wrong_item", "description": "got the wrong size", "desired_outcome": "replacement", "product_hint": "floor mats"}, "expected_action": "propose_refund", "expected_tools": ["lookup_order", "check_warranty", "check_inventory", "create_ticket"], "expected_denied": false}
{"id": "s11", "name": "repair request routed to staff", "principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "spec": {"order_id": 1042, "category": "defective", "description": "stitching came loose", "desired_outcome": "repair"}, "expected_action": "ticket_only", "expected_tools": ["lookup_order", "check_warranty", "create_ticket"], "expected_denied": false}
{"id": "s12", "name": "customer direct refund tool call is denied", "tool_call": {"principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "tool": "issue_refund", "args": {"order_id": 1042, "amount_cents": 2499, "reason": "x"}}, "expected_action": "denied", "expected_tools": ["issue_refund"], "expected_denied": true}
{"id": "s13", "name": "staff refund tool call is denied", "tool_call": {"principal": {"subject": "staff-a", "tenant": "store-a", "scopes": ["staff:read_all"]}, "tool": "issue_refund", "args": {"order_id": 1042, "amount_cents": 2499, "reason": "x"}}, "expected_action": "denied", "expected_tools": ["issue_refund"], "expected_denied": true}
{"id": "s14", "name": "manager refund tool call succeeds", "tool_call": {"principal": {"subject": "mgr-a", "tenant": "store-a", "scopes": ["staff:read_all", "manager:refund"]}, "tool": "issue_refund", "args": {"order_id": 1042, "amount_cents": 2499, "reason": "approved"}}, "expected_action": "ok", "expected_tools": ["issue_refund"], "expected_denied": false}
{"id": "s15", "name": "manager cannot refund other tenant", "tool_call": {"principal": {"subject": "mgr-a", "tenant": "store-a", "scopes": ["staff:read_all", "manager:refund"]}, "tool": "issue_refund", "args": {"order_id": 3000, "amount_cents": 1, "reason": "x"}}, "expected_action": "not_found", "expected_tools": ["issue_refund"], "expected_denied": true}
{"id": "s16", "name": "customer cannot schedule service", "tool_call": {"principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "tool": "schedule_service", "args": {"order_id": 1042, "preferred_date": "2027-01-10"}}, "expected_action": "denied", "expected_tools": ["schedule_service"], "expected_denied": true}
{"id": "s17", "name": "staff schedules service", "tool_call": {"principal": {"subject": "staff-a", "tenant": "store-a", "scopes": ["staff:read_all"]}, "tool": "schedule_service", "args": {"order_id": 1042, "preferred_date": "2027-01-10"}}, "expected_action": "ok", "expected_tools": ["schedule_service"], "expected_denied": false}
{"id": "s18", "name": "kill switch blocks manager", "tool_call": {"principal": {"subject": "mgr-a", "tenant": "store-a", "scopes": ["staff:read_all", "manager:refund"]}, "tool": "lookup_order", "args": {"order_id": 1042}, "kill_switch": true}, "expected_action": "denied", "expected_tools": ["lookup_order"], "expected_denied": true}
{"id": "s19", "name": "invalid input rejected before business logic", "tool_call": {"principal": {"subject": "cust-0001", "tenant": "store-a", "scopes": ["customer:read_own"]}, "tool": "create_ticket", "args": {"order_id": 1042, "category": "furious", "summary": "x"}}, "expected_action": "invalid_input", "expected_tools": ["create_ticket"], "expected_denied": false}
{"id": "s20", "name": "unknown tool", "tool_call": {"principal": {"subject": "mgr-a", "tenant": "store-a", "scopes": ["staff:read_all", "manager:refund"]}, "tool": "export_customers", "args": {}}, "expected_action": "denied", "expected_tools": ["export_customers"], "expected_denied": true}
